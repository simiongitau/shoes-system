@@ -0,0 +1,90 @@
+"use client";
+
+import Link from "next/link";
+import { Autoplay, Pagination } from "swiper/modules";
+import { Swiper as SwiperComponent, SwiperSlide } from "swiper/react";
+import "swiper/css";
+import "swiper/css/pagination";
+import type { ReactElement } from "react";
+import { Button } from "@/components/ui/button";
+
+export interface HeroSlide {
+  id: string;
+  /** Tailwind gradient classes, used when no background image is supplied. */
+  gradientClassName: string;
+  eyebrow: string;
+  title: string;
+  subtitle: string;
+  ctaLabel: string;
+  ctaHref: string;
+  /** Optional real promo image (e.g. uploaded via CMS later). Falls back to the gradient above. */
+  imageUrl?: string;
+}
+
+interface HeroCarouselProps {
+  slides: HeroSlide[];
+}
+
+/**
+ * Rotating promo-banner carousel for the homepage, in the style of
+ * Jumia / Beauty Kenya seasonal-sale hero sections. Autoplays with
+ * pagination dots; pauses on hover/interaction via Swiper defaults.
+ */
+export function HeroCarousel({ slides }: HeroCarouselProps): ReactElement {
+  if (slides.length === 0) {
+    return <></>;
+  }
+
+  return (
+    <section className="border-b border-gray-200">
+      <SwiperComponent
+        modules={[Autoplay, Pagination]}
+        autoplay={{ delay: 5000, disableOnInteraction: false }}
+        pagination={{ clickable: true }}
+        loop={slides.length > 1}
+        className="hero-carousel"
+      >
+        {slides.map((slide) => (
+          <SwiperSlide key={slide.id}>
+            <div
+              className={`relative flex items-center min-h-[420px] md:min-h-[480px] ${
+                slide.imageUrl ? "" : slide.gradientClassName
+              }`}
+              style={
+                slide.imageUrl
+                  ? {
+                      backgroundImage: `url(${slide.imageUrl})`,
+                      backgroundSize: "cover",
+                      backgroundPosition: "center",
+                    }
+                  : undefined
+              }
+            >
+              {/* Dark overlay improves text legibility over photos; harmless over gradients too */}
+              <div className="absolute inset-0 bg-black/20" />
+
+              <div className="relative container mx-auto px-4 sm:px-6 lg:px-8 py-12">
+                <div className="max-w-xl text-white">
+                  <span className="inline-block text-sm font-semibold tracking-wide uppercase bg-white/15 px-3 py-1 rounded-full mb-4">
+                    {slide.eyebrow}
+                  </span>
+                  <h1 className="text-3xl md:text-5xl font-bold tracking-tight text-balance">
+                    {slide.title}
+                  </h1>
+                  <p className="mt-4 text-base md:text-lg text-white/90 max-w-md">
+                    {slide.subtitle}
+                  </p>
+                  <div className="mt-8">
+                    <Button size="lg" asChild>
+                      <Link href={slide.ctaHref}>{slide.ctaLabel}</Link>
+                    </Button>
+                  </div>
+                </div>
+              </div>
+            </div>
+          </SwiperSlide>
+        ))}
+      </SwiperComponent>
+    </section>
+  );
+}
